# ==============================================================================
# LLM Provider Configuration
# Set USE_LOCAL_LLM=true to use local Ollama model on the host.
# Set USE_LOCAL_LLM=false to use an external LLM API.
# ==============================================================================
USE_LOCAL_LLM=false

# ==============================================================================
# 1. Local Ollama Settings (used when USE_LOCAL_LLM=true)
# ==============================================================================
OLLAMA_MODEL=llama3.2
# When running locally:
OLLAMA_BASE_URL=http://localhost:11434
# When running inside Docker (reaches Ollama running on your host machine):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==============================================================================
# 2. External LLM API Settings (used when USE_LOCAL_LLM=false)
# Works with ANY provider: Google Gemini, OpenAI, Groq, DeepSeek, Mistral, OpenRouter, etc.
# ==============================================================================
# Your API key (can also be specified as GEMINI_API_KEY, OPENAI_API_KEY, LLM_API_KEY)
EXTERNAL_API_KEY=

# Model name:
# - Google Gemini: gemini-2.5-flash, gemini-3.8-flash
# - OpenAI:        gpt-4o, gpt-4o-mini
# - Groq:          llama-3.3-70b-versatile, mixtral-8x7b-32768
# - DeepSeek:      deepseek-chat
# - Mistral:       mistral-small-latest
# - OpenRouter:    meta-llama/llama-3.3-70b-instruct
EXTERNAL_MODEL=gemini-3.8-flash

# Optional custom base URL for OpenAI-compatible providers:
# - Groq:       https://api.groq.com/openai/v1
# - DeepSeek:   https://api.deepseek.com/v1
# - Mistral:    https://api.mistral.ai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# (Leave empty for official Google Gemini SDK or OpenAI default https://api.openai.com/v1)
EXTERNAL_BASE_URL=
