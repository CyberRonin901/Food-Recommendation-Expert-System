# Set to true to use local Ollama model on the host; set to false (or omit) to use Google Gemini
USE_LOCAL_LLM=false

# Ollama settings (used when USE_LOCAL_LLM=true)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# Note for Docker users: if running app in Docker and Ollama is on host machine, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Gemini settings (used when USE_LOCAL_LLM=false)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
